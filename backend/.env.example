DJANGO_SECRET_KEY=change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.bynzuri.com

# Production: DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DB_ENGINE=django.db.backends.postgresql
DB_NAME=bynzuri
DB_USER=bynzuri
DB_PASSWORD=bynzuri
DB_HOST=localhost
DB_PORT=5432

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
# Public media hostname only, e.g. media.example.com (no https://)
R2_PUBLIC_DOMAIN=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173

MICHOWAPI_API_KEY=
MICHOWAPI_WEBHOOK_SECRET=

# Lenco API token (use a sandbox token for testing)
LENCO_API_KEY=
